# ─────────────────────────────────────────────────────
# VARIABLES NECESARIAS PARA NSK v2
# Copia este archivo como .env y rellena los valores
# ─────────────────────────────────────────────────────

# Supabase (obtenlas en: app.supabase.com → Settings → API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...  # anon/public key

# Opcionales (frontend) — si no se definen, se usa un fallback hardcoded equivalente
# VITE_INGEST_URL=https://tu-proyecto.supabase.co/functions/v1/ingest-usage  # endpoint de ingesta usado por Monitor.tsx
# VITE_APK_URL=https://github.com/DiegoDeris/nsk-android/releases/latest/download/app-debug.apk  # APK de la app móvil (InstallToken.tsx)

# ─── Para las Edge Functions (se configuran en Supabase, NO en Vercel) ───
# Supabase Dashboard → Edge Functions → Secrets
#   GEMINI_API_KEY=AIza...   ← obtenla gratis en https://aistudio.google.com

# Production hardening 2026-06-10
#   NOTIFY_ALERT_SECRET=...      # Secret compartido entre el trigger DB (fn_notify_alert) y notify-alert.
#                                 # Existe un fallback hardcoded, pero se recomienda configurar este valor.
#   FROM_EMAIL="NeuroShield Kids <onboarding@resend.dev>"  # Remitente verificado en Resend para emails
#                                 # transaccionales (alertas, avisos de cron). Fallback: onboarding@resend.dev (dominio de pruebas).
#   RESEND_API_KEY=re_...         # API key de Resend para el envío de emails transaccionales.
#   CRON_SECRET=...               # Usado para autenticar llamadas de pg_cron a edge functions (p.ej. daily-analysis).

# ─── Stripe (Edge Functions: create-checkout, sync-subscription, stripe-webhook) ───
# Se configuran en Supabase, NUNCA en el frontend/.env de Vite (son secrets, no VITE_*)
#   STRIPE_SECRET_KEY=sk_...       # Clave secreta de Stripe (modo live o test).
#   STRIPE_WEBHOOK_SECRET=whsec_...# Firma del webhook de Stripe, usada por stripe-webhook para verificar eventos.
#   STRIPE_PRICE_BASIC_MONTHLY=price_...    # IDs de precios de Stripe usados por create-checkout
#   STRIPE_PRICE_BASIC_ANNUAL=price_...     # para mapear cada plan a su Price ID correspondiente.
#   STRIPE_PRICE_PREMIUM_MONTHLY=price_...
#   STRIPE_PRICE_PREMIUM_ANNUAL=price_...
